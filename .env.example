# Quorum-Zeolite Environment Configuration

# Database: SQLite used by default if DATABASE_URL is not set
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quorum_zeolite

# Resolution Profile: laptop (Nr=10, Nz=100) or university (Nr=40, Nz=500)
RESOLUTION_PROFILE=laptop

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Optional LLM API Key for Automated Report Enrichment
# GROQ_API_KEY=your_groq_api_key_here
